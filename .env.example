# Copy this file to .env.local and fill in the values from Supabase:
# Dashboard → Project Settings → API

# Safe to expose in the browser (read-only thanks to Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET — server/scanner only. Never commit this or put it in NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
