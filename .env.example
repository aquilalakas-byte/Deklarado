# Copy this file to .env.local and fill in the values from Supabase:
# Dashboard → Project Settings → API

# Safe to expose in the browser (read-only thanks to Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET — server/scanner only. Never commit this or put it in NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Push notifications. Generate a pair with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# SECRET — server/scanner only
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact for push services, e.g. mailto:yourteam@gmail.com
VAPID_SUBJECT=mailto:change-me@example.com
